{
  "name": "three-dog",
  "version": "1.11.2",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist && rimraf client/dist",
    "build": "nest build && npm run build:client",
    "build:client": "vue-tsc -p client/tsconfig.json && vite build ./client",
    "format": "prettier --write \"src/**/*.ts\" \"client/src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:hmr": "npm run prebuild && nest build --webpack --webpackPath webpack-hmr.config.js --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:client": "vite ./client",
    "lint": "eslint \"{src,client/src,apps,libs,test}/**/*.{ts,vue}\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "semantic-release": "semantic-release",
    "prepare": "is-ci || husky install"
  },
  "dependencies": {
    "@discord-nestjs/common": "^5.3.2",
    "@discord-nestjs/core": "^5.5.1",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/serve-static": "^5.0.4",
    "@snazzah/davey": "^0.1.9",
    "axios": "^1.15.0",
    "bulma": "^0.9.4",
    "cache-manager": "^6.4.3",
    "discord.js": "^14.25.1",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.2.0",
    "node-gyp": "^11.5.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.0",
    "rxjs": "^7.8.0",
    "sodium": "^3.0.2",
    "vue": "^3.4.26"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.5.0",
    "@nestjs/schematics": "^9.0.4",
    "@nestjs/testing": "^11.1.9",
    "@semantic-release/changelog": "^6.0.2",
    "@semantic-release/commit-analyzer": "^9.0.2",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^8.0.7",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@types/cache-manager": "^4.0.2",
    "@types/cron": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "28.1.4",
    "@types/node": "^22.0.0",
    "@types/supertest": "^2.0.15",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^8.0.3",
    "is-ci": "^3.0.1",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "run-script-webpack-plugin": "^0.2.3",
    "sass": "^1.57.1",
    "semantic-release": "^25.0.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.3.1",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/Pragma8123/three-dog.git"
  }
}
